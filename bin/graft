#!/usr/bin/env bash
#
# graft - link one shared AI-agent context repo into many project checkouts.
#
# https://github.com/herbeus/graft
# SPDX-License-Identifier: MIT
#
# This file owns argument parsing, dispatch and every headline printed to the
# user. Nothing under lib/ prints a headline or calls exit.

set -euo pipefail

GRAFT_VERSION="0.1.0"

# --- locate our own lib/ ------------------------------------------------------
# install.sh symlinks this file into ~/.local/bin, so $0 is usually a symlink and
# we have to walk the chain ourselves. This runs before core.sh exists, so it
# cannot use the helpers from there.
graft_self_dir() {
	local p="${BASH_SOURCE[0]}" n=0 link
	while [ -L "$p" ] && [ "$n" -lt 40 ]; do
		link=$(readlink -- "$p")
		case "$link" in
		/*) p="$link" ;;
		*) p="$(dirname -- "$p")/$link" ;;
		esac
		n=$((n + 1))
	done
	(cd -P -- "$(dirname -- "$p")" && pwd -P)
}

GRAFT_BIN_DIR=$(graft_self_dir)
GRAFT_HOME=$(cd -P -- "$GRAFT_BIN_DIR/.." && pwd -P)
GRAFT_LIB="$GRAFT_HOME/lib"

if [ ! -r "$GRAFT_LIB/core.sh" ]; then
	printf 'graft: cannot find lib/ next to %s\n' "$GRAFT_BIN_DIR" >&2
	printf '      reinstall, or run bin/graft from a complete checkout\n' >&2
	exit 4
fi

# shellcheck source=lib/core.sh
. "$GRAFT_LIB/core.sh"
# shellcheck source=lib/config.sh
. "$GRAFT_LIB/config.sh"
# shellcheck source=lib/state.sh
. "$GRAFT_LIB/state.sh"
# shellcheck source=lib/discover.sh
. "$GRAFT_LIB/discover.sh"
# shellcheck source=lib/apply.sh
. "$GRAFT_LIB/apply.sh"
# shellcheck source=lib/plan.sh
. "$GRAFT_LIB/plan.sh"

# --- usage --------------------------------------------------------------------

graft_usage() {
	cat <<'USAGE'
graft - one shared agent context, linked into every repo you work on.

usage:
  graft [link] [<target>...]   create and repair the configured links
  graft status [<target>...]   show what is linked, drifted or missing
  graft check                  validate graft.conf, touch nothing
  graft unlink [<target>...]   remove our links and restore backups
  graft adopt <dir> --as NAME  take an existing dir into the context repo
  graft init                   write a starter graft.conf
  graft version                print the version
  graft help                   this text

options:
  -n, --dry-run       print the plan, change nothing
  -y, --yes           assume yes for every question
      --no-input      never ask (implied when stdin is not a terminal)
  -C, --config PATH   path to graft.conf (default: search upwards from $PWD)
      --path N=DIR    pin target N to DIR and remember it (repeatable)
      --rescan        ignore the discovery cache
      --only NAME     only links whose destination is named NAME
      --force         replace foreign symlinks (never tracked files)
  -q, --quiet         errors only
      --json          machine-readable output, implies --no-input
      --no-color      no ANSI colour (also honours NO_COLOR)
  -h, --help          this text
  -V, --version       version

exit codes:
  0 done                          1 drift or conflict
  2 bad usage or config           3 changes needed but not confirmed
  4 environment unusable        130 interrupted

environment:
  GRAFT_CONFIG   path to graft.conf, same as --config
  NO_COLOR       disable colour, same as --no-color
  CI             any value implies --no-input

full documentation: docs/ in the repo, or https://github.com/herbeus/graft
USAGE
}

# --- argument parsing ---------------------------------------------------------

GRAFT_CMD=""
GRAFT_ARGS="" # newline-separated positional arguments
GRAFT_PINS="" # newline-separated NAME=DIR
GRAFT_ONLY="" # newline-separated destination basenames
GRAFT_CONF_ARG=""
GRAFT_RESCAN=0
GRAFT_FORCE=0
GRAFT_ADOPT_AS=""
GRAFT_NO_COLOR=0

graft_is_command() {
	case "$1" in
	link | status | check | unlink | adopt | init | version | help) return 0 ;;
	esac
	return 1
}

graft_parse_args() {
	local a
	while [ $# -gt 0 ]; do
		a="$1"
		case "$a" in
		-n | --dry-run) GRAFT_DRY_RUN=1 ;;
		-y | --yes) GRAFT_ASSUME_YES=1 ;;
		--no-input) GRAFT_NO_INPUT=1 ;;
		-q | --quiet) GRAFT_QUIET=1 ;;
		--json)
			GRAFT_JSON=1
			GRAFT_NO_INPUT=1
			GRAFT_NO_COLOR=1
			;;
		--no-color) GRAFT_NO_COLOR=1 ;;
		--rescan) GRAFT_RESCAN=1 ;;
		--force) GRAFT_FORCE=1 ;;
		-h | --help)
			graft_usage
			exit 0
			;;
		-V | --version)
			printf 'graft %s\n' "$GRAFT_VERSION"
			exit 0
			;;
		-C | --config)
			[ $# -ge 2 ] || gr_die "$GRAFT_EX_USAGE" "--config needs a path"
			GRAFT_CONF_ARG="$2"
			shift
			;;
		--config=*) GRAFT_CONF_ARG="${a#--config=}" ;;
		--path)
			[ $# -ge 2 ] || gr_die "$GRAFT_EX_USAGE" "--path needs NAME=DIR"
			GRAFT_PINS="$GRAFT_PINS$2"$'\n'
			shift
			;;
		--path=*) GRAFT_PINS="$GRAFT_PINS${a#--path=}"$'\n' ;;
		--only)
			[ $# -ge 2 ] || gr_die "$GRAFT_EX_USAGE" "--only needs a name"
			GRAFT_ONLY="$GRAFT_ONLY$2"$'\n'
			shift
			;;
		--only=*) GRAFT_ONLY="$GRAFT_ONLY${a#--only=}"$'\n' ;;
		--as)
			[ $# -ge 2 ] || gr_die "$GRAFT_EX_USAGE" "--as needs a target name"
			GRAFT_ADOPT_AS="$2"
			shift
			;;
		--as=*) GRAFT_ADOPT_AS="${a#--as=}" ;;
		--)
			shift
			while [ $# -gt 0 ]; do
				GRAFT_ARGS="$GRAFT_ARGS$1"$'\n'
				shift
			done
			return 0
			;;
		-*)
			gr_err "unknown option: $(gr_clean "$a")"
			gr_hint "graft --help lists every option"
			exit "$GRAFT_EX_USAGE"
			;;
		*)
			if [ -z "$GRAFT_CMD" ] && graft_is_command "$a"; then
				GRAFT_CMD="$a"
			else
				GRAFT_ARGS="$GRAFT_ARGS$a"$'\n'
			fi
			;;
		esac
		shift
	done
}

# --- config bootstrap ---------------------------------------------------------

graft_need_config() {
	local conf
	if [ -n "$GRAFT_CONF_ARG" ]; then
		conf=$(gr_abspath "$GRAFT_CONF_ARG")
		[ -r "$conf" ] || gr_die "$GRAFT_EX_USAGE" "no such config: $(gr_clean "$conf")"
	elif [ -n "${GRAFT_CONFIG:-}" ]; then
		conf=$(gr_abspath "$GRAFT_CONFIG")
		[ -r "$conf" ] || gr_die "$GRAFT_EX_USAGE" "GRAFT_CONFIG points at nothing: $(gr_clean "$conf")"
	else
		conf=$(cfg_find_conf "$PWD") || {
			gr_err "no graft.conf found in $(gr_clean "$PWD") or any parent"
			gr_hint "cd into your context repo, or run: graft init"
			gr_hint "or point at one explicitly: graft --config path/to/graft.conf"
			exit "$GRAFT_EX_USAGE"
		}
	fi

	if ! cfg_load "$conf"; then
		cfg_print_errors
		exit "$GRAFT_EX_USAGE"
	fi

	# Every module that needs to know where "inside the context repo" is gets
	# told once, here, rather than each of them re-deriving it.
	st_init "$CFG_FILE"
	st_load "$CFG_FILE"
	ap_set_context "$CFG_CTX_ROOT"
	# Run-wide rather than a per-link argument, because unlink has to find the
	# backup again later and has no link record to carry it.
	ap_set_backup_suffix "$(cfg_get defaults backup_suffix .graft-backup)" || :
}

# --- commands -----------------------------------------------------------------

# Validating only the grammar is not much of a check: the commonest mistake is
# a source directory that does not exist, and a green tick for a config whose
# every link points at nothing is worse than no check at all.
graft_check_sources() {
	local t spec src missing=0
	while IFS= read -r t; do
		[ -n "$t" ] || continue
		while IFS= read -r spec; do
			[ -n "$spec" ] || continue
			src=${spec%%	*}
			{ [ -e "$src" ] || [ -L "$src" ]; } && continue
			missing=$((missing + 1))
			gr_warn "$t: source does not exist: $(gr_clean "${src#"$CFG_CTX_ROOT"/}")"
		done <<EOF
$(cfg_target_links "$t")
EOF
	done <<EOF
$(cfg_targets)
EOF
	[ "$missing" = 0 ] && return 0
	gr_hint "create it under $(gr_clean "${CFG_SOURCE_ROOT#"$CFG_CTX_ROOT"/}")/, or fix the link line"
	return 1
}

cmd_check() {
	local nt ns rc=0
	graft_need_config
	nt=$(cfg_targets | grep -c . || true)
	ns=$(cfg_setups | grep -c . || true)
	gr_say "graft.conf: $(gr_clean "$CFG_FILE")"
	graft_check_sources || rc="$GRAFT_EX_DRIFT"
	if [ "$rc" = 0 ]; then
		gr_ok "syntax, schema and sources are all in order"
	fi
	gr_dim "  $(gr_plural "$nt" target targets), $(gr_plural "$ns" "setup note" "setup notes")"
	return "$rc"
}

cmd_version() {
	printf 'graft %s\n' "$GRAFT_VERSION"
}

# --- main ---------------------------------------------------------------------

main() {
	graft_parse_args "$@"
	[ -n "${CI:-}" ] && GRAFT_NO_INPUT=1
	[ -t 0 ] || GRAFT_NO_INPUT=1
	gr_init_style

	case "${GRAFT_CMD:-link}" in
	help)
		graft_usage
		;;
	version)
		cmd_version
		;;
	check)
		cmd_check
		;;
	link)
		graft_need_config
		plan_cmd_link
		;;
	status)
		graft_need_config
		plan_cmd_status
		;;
	unlink)
		graft_need_config
		plan_cmd_unlink
		;;
	adopt)
		graft_need_config
		plan_cmd_adopt
		;;
	init)
		plan_cmd_init
		;;
	*)
		gr_die "$GRAFT_EX_USAGE" "unknown command: $(gr_clean "$GRAFT_CMD")"
		;;
	esac
}

trap 'exit 130' INT
main "$@"
